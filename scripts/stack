#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
compose=(docker compose --project-directory "${repo_dir}" -f "${repo_dir}/compose.yaml")
command="${1:-up}"
service_id="web-research-mcp"
service_version="0.1.7"

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "required command not found: $1" >&2
    exit 1
  fi
}

show_failure() {
  "${compose[@]}" ps || true
  "${compose[@]}" logs --no-color --tail 200 gateway searxng firecrawl-api || true
}

wait_for_searxng_health() {
  local container_id
  local health_state
  local attempt

  container_id="$("${compose[@]}" ps --quiet searxng)"
  for attempt in $(seq 1 30); do
    health_state="$(docker inspect --format '{{.State.Health.Status}}' "${container_id}" 2>/dev/null || true)"
    if [[ "${health_state}" == "healthy" ]]; then
      return 0
    fi
    if [[ "${health_state}" == "unhealthy" ]]; then
      echo "searxng became unhealthy after restart" >&2
      return 1
    fi
    sleep 1
  done
  echo "timed out waiting for searxng after restart" >&2
  return 1
}

wait_until_ready() {
  local port="${WEB_RESEARCH_MCP_PORT:-9213}"
  local endpoint="http://127.0.0.1:${port}"
  local attempt

  for attempt in $(seq 1 90); do
    if curl --fail --silent --show-error --max-time 5 "${endpoint}/healthz" >/dev/null \
      && "${compose[@]}" exec -T gateway /usr/local/bin/service smoke --backend searxng \
      && "${compose[@]}" exec -T gateway /usr/local/bin/service smoke --backend firecrawl; then
      echo
      echo "web-research-mcp is ready"
      echo "MCP endpoint: ${endpoint}/mcp"
      echo "Health:       ${endpoint}/healthz"
      echo "Metrics:      ${endpoint}/metrics"
      return 0
    fi
    echo "waiting for the real search/extraction stack (${attempt}/90)"
    sleep 10
  done

  echo "web-research-mcp did not become ready" >&2
  show_failure
  return 1
}

start_stack() {
  require_command docker
  require_command curl
  if [[ -n "${WEB_RESEARCH_MCP_IMAGE:-}" ]]; then
    "${compose[@]}" up --detach --pull never
  else
    "${compose[@]}" up --detach --pull always
  fi
  # Compose does not recreate a running container when only a bind-mounted
  # settings file changes. Restart SearXNG so `stack up` always applies the
  # search profile shipped by the checked-out repository.
  "${compose[@]}" restart searxng
  wait_for_searxng_health
  wait_until_ready
}

run_gents_scoped() {
  local gents_bin="$1"
  shift

  if [[ -n "${GENTS_GRAPHQL:-}" ]]; then
    "${gents_bin}" "$@" --graphql "${GENTS_GRAPHQL}"
  elif [[ -n "${GENTS_HOME:-}" ]]; then
    "${gents_bin}" "$@" --home "${GENTS_HOME}"
  else
    "${gents_bin}" "$@"
  fi
}

install_mcp() {
  local gents_bin="${GENTS_BIN:-gents}"
  local port="${WEB_RESEARCH_MCP_PORT:-9213}"
  local endpoint="http://127.0.0.1:${port}/mcp"
  local scope_hint=""

  if [[ -n "${GENTS_GRAPHQL:-}" && -n "${GENTS_HOME:-}" ]]; then
    echo "set only one of GENTS_GRAPHQL or GENTS_HOME" >&2
    return 2
  fi
  if [[ -n "${GENTS_GRAPHQL:-}" ]]; then
    scope_hint=" --graphql ${GENTS_GRAPHQL}"
  elif [[ -n "${GENTS_HOME:-}" ]]; then
    scope_hint=" --home ${GENTS_HOME}"
  fi

  require_command "${gents_bin}"
  start_stack
  run_gents_scoped "${gents_bin}" mcp register "${service_id}" \
    --endpoint "${endpoint}" \
    --display-name "Web Research MCP" \
    --description "Local bounded web evidence gateway" \
    --version "${service_version}" \
    --send-agent-did
  run_gents_scoped "${gents_bin}" mcp probe "${service_id}" --timeout 30s

  echo
  echo "web-research-mcp is installed in Gents"
  echo "Next: ${gents_bin} graph install web-deep-research${scope_hint}"
  echo "Then: ${gents_bin} graph run web-deep-research --question \"...\" --watch${scope_hint}"
}

case "${command}" in
  up)
    start_stack
    ;;
  install-mcp)
    install_mcp
    ;;
  down)
    require_command docker
    "${compose[@]}" down --remove-orphans
    ;;
  reset)
    require_command docker
    "${compose[@]}" down --volumes --remove-orphans
    ;;
  status)
    require_command docker
    "${compose[@]}" ps
    ;;
  logs)
    require_command docker
    "${compose[@]}" logs --follow --tail 200
    ;;
  *)
    echo "usage: $0 {up|install-mcp|down|reset|status|logs}" >&2
    exit 2
    ;;
esac
